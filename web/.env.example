# ── RobinShare (FLEDGE) web env ─────────────────────────────────────────────
# PUBLIC (se exponen al browser, prefijo NEXT_PUBLIC_):
NEXT_PUBLIC_FACTORY_ADDRESS=0x        # la RobinShareVaultFactory desplegada en 4663 (output del
                                      # `forge script script/DeployPons.s.sol` — ver
                                      # docs/RUNBOOK-launch-pons.md §3)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# NEXT_PUBLIC_DIRECTION — opcional, NO seteés esto en prod. Sin definir, cae a "legend"
# (ganadora del bake-off 2026-07-13, identidad oficial de RobinShare). Solo sirve para forzar
# otra dirección de arte archivada (sky/nest/avion/sherwood/hood/decree/terminal/manga) en un
# preview branch de Vercel — todas siguen navegables en prod vía /v/<dir> sin tocar esta var.
# NEXT_PUBLIC_DIRECTION=legend

# SECRETOS (SOLO server — nunca prefijo NEXT_PUBLIC_):
ATTESTER_PK=0x                        # PK de una wallet NUEVA y dedicada (sin fondos). Su ADDRESS
                                      # debe ser la que se le pasó a la factory como attester
                                      # canónico (ATTESTER_ADDRESS en docs/RUNBOOK-launch.md paso 0/1).
                                      # Si no coincide, GET /api/health devuelve attesterMatches:false
                                      # y TODO claim de github/X revierte.
ATTESTER_STATE_SECRET=                # string aleatorio largo (firma el state del OAuth de GitHub).
                                      # generalo con: openssl rand -hex 32
GITHUB_CLIENT_ID=                     # GitHub OAuth App — github.com/settings/developers → New OAuth App
GITHUB_CLIENT_SECRET=                 # callback exacto: <APP_BASE_URL>/api/attest/github/callback
# Twitter/X: NO VA. El lanzamiento sale sin la ruta de X (PENDIENTES §4): la factory se deploya
# con `xVerifier = 0`, así que `createVault` con identityType=2 revierte en cadena y /create sólo
# ofrece GitHub y wallet. No hay env que configurar, y volver a ofrecerla exigiría redeployar la
# factory (`xVerifier` es immutable ahí también).

# ── RELAYER (opcional, pero es la promesa central del producto) ─────────────
# Sin esto la app funciona igual: el dev firma y paga su propio gas. Con esto, el server manda
# el claim por él y un builder que nunca tuvo ETH en 4663 igual cobra.
# ⚠️ Es una WALLET CALIENTE CON FONDOS. Que sea dedicada, con poco saldo, y sólo para esto.
# La política anti-abuso está en web/lib/relay.ts (sólo se relayan vouchers que firmamos
# nosotros, sobre vaults de nuestra factory, no bindeados y ya atados a una moneda real).
RELAYER_PK=                           # PK de la wallet que paga el gas de los claims
RELAYER_MIN_BALANCE_WEI=              # opcional; default 0,002 ETH. Por debajo, el relayer se
                                      # declara apagado y la UI ofrece el camino normal.
# Estado en vivo: GET /api/relay/claim  → { enabled }   (nada mas: no se publica el saldo)

# ── KEEPER (no va en Vercel: es un cron aparte) ─────────────────────────────
# KEEPER_PK=                          # wallet que paga el gas de sweepCurve/pull. NO necesita
#                                     # ningún privilegio: harvest() es permissionless.
# MIN_HARVEST_WEI=200000000000000     # piso para no gastar gas moviendo polvo
#   cd web && KEEPER_PK=0x... NEXT_PUBLIC_FACTORY_ADDRESS=0x... node scripts/keeper.mjs --send

# Dominio público de la app, EXACTO (para armar el redirect del OAuth de GitHub):
# En producción: https://www.robinshareapp.com  (CON www — el apex hace 308 hacia ahí, y el
# callback de la OAuth App tiene que coincidir carácter por carácter). Sin barra final.
APP_BASE_URL=http://localhost:3000
